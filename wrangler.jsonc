{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profitplus",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://profitplus.cj5v2tzbtr.workers.dev",
    "PLATFORM_ADMIN_EMAIL_SHA256": "e4542a9170c094cea92b259bc7b6bf6113e285e1f084c616daaf8ddae40307da",
    "PLATFORM_ADMIN_SETUP_EMAIL_SHA256": "e4542a9170c094cea92b259bc7b6bf6113e285e1f084c616daaf8ddae40307da",
    "PLATFORM_ADMIN_SETUP_TOKEN_SHA256": "13e636387b7ddde24e7e532300ae4e2dcab3f316d873e8daa68e9a34bd9a586d",
    "PLATFORM_ADMIN_SETUP_EXPIRES_AT": "2026-10-17T16:45:00.000Z",
    "PLATFORM_ADMIN_SETUP_MODE": "recover"
  },
  "durable_objects": {
    "bindings": [{ "name": "DATABASE", "class_name": "ProfitPulseDatabase" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProfitPulseDatabase"] }
  ],
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
  "observability": { "enabled": true }
}
