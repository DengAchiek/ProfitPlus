PORT=8080
BIND_HOST=127.0.0.1
# DATA_DIR=/absolute/path/to/persistent/bizatrio-data
# For deployment behind an HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://bizatrio.example.com
# Platform-wide administrator. Use an existing account or the private setup flow.
# Business owners and staff are not platform administrators.
# PLATFORM_ADMIN_EMAILS=your-existing-account@example.com
# Optional single-use setup invitation for an unregistered reserved administrator:
# PLATFORM_ADMIN_SETUP_EMAIL_SHA256=sha256-of-lowercase-trimmed-email
# PLATFORM_ADMIN_SETUP_TOKEN_SHA256=sha256-of-a-random-32-byte-hex-code
# PLATFORM_ADMIN_SETUP_EXPIRES_AT=ISO-8601-expiry-time-in-UTC
# PLATFORM_ADMIN_SETUP_MODE=create
# To recover an existing approved admin, issue a fresh code and set mode=recover.
# Share the raw setup code privately; never commit it or an account password.
# BIND_HOST=0.0.0.0
# Optional full Unicode fonts for PDFs (absolute TTF/OTF paths):
# PDF_FONT_REGULAR=/path/to/NotoSans-Regular.ttf
# PDF_FONT_BOLD=/path/to/NotoSans-Bold.ttf

# Stripe subscriptions (leave unset while configuring prices before launch).
# Use test-mode keys/price IDs first. Never commit a real .env file.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Prices must be active, fixed recurring prices, quantity 1, one month or one year.
# Add only currencies offered by your Stripe merchant account. No automatic FX pricing.
# STRIPE_PRICES_JSON='{"starter":{"USD":{"month":"price_replace_starter"}},"growth":{"USD":{"month":"price_replace_growth"}},"business":{"USD":{"month":"price_replace_business"}}}'
# For local Stripe testing, also set PUBLIC_ORIGIN=http://127.0.0.1:8080
# Public production billing requires the HTTPS origin and a configured webhook endpoint.

# Optional initial Meta configuration. Prefer the platform-admin Connections screen.
# Set real credentials only in private environment variables / Cloudflare secrets.
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
# META_API_VERSION=v24.0
# Configure the redirect and webhook URLs shown in Connections in the Meta app.
# Client Twilio credentials are provided privately in their own Connections screen.
