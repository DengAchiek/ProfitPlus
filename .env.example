PORT=8080
BIND_HOST=127.0.0.1
# DATA_DIR=/absolute/path/to/persistent/profitpulse-data
# For deployment behind an HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://profitpulse.example.com
# Platform-wide administrator. This must be an existing registered account.
# Business owners and staff are not platform administrators.
# PLATFORM_ADMIN_EMAILS=your-existing-account@example.com
# BIND_HOST=0.0.0.0
# Optional full Unicode fonts for PDFs (absolute TTF/OTF paths):
# PDF_FONT_REGULAR=/path/to/NotoSans-Regular.ttf
# PDF_FONT_BOLD=/path/to/NotoSans-Bold.ttf

# Stripe subscriptions (leave unset while configuring prices before launch).
# Use test-mode keys/price IDs first. Never commit a real .env file.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Prices must be active, fixed recurring prices, quantity 1, one month or one year.
# Add only currencies offered by your Stripe merchant account. No automatic FX pricing.
# STRIPE_PRICES_JSON='{"starter":{"USD":{"month":"price_replace_starter"}},"growth":{"USD":{"month":"price_replace_growth"}},"business":{"USD":{"month":"price_replace_business"}}}'
# For local Stripe testing, also set PUBLIC_ORIGIN=http://127.0.0.1:8080
# Public production billing requires the HTTPS origin and a configured webhook endpoint.
